{
  "openrpc": "1.3.2",
  "info": {
    "title": "MRTKLIB real-time server (mrtk run) JSON-RPC interface",
    "version": "0.1",
    "description": "Draft. Machine-readable contract for the JSON-RPC 2.0 interface of `mrtk run`, served over WebSocket. The human-readable reference is README.md in this directory; read it for transport, authentication, process startup and the meaning of each field. This file describes exactly protocol version 0.1: every object is closed (additionalProperties false) so that mocks and contract tests detect stray members. Clients must still ignore unknown members, because later minor versions add members."
  },
  "methods": [
    {
      "name": "getVersion",
      "summary": "Protocol and library versions.",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "version",
        "schema": {
          "$ref": "#/components/schemas/VersionResult"
        }
      },
      "examples": [
        {
          "name": "token authentication",
          "params": [],
          "result": {
            "name": "version",
            "value": {
              "protocolVersion": "0.1",
              "mrtklibVersion": "0.7.11",
              "authentication": "token"
            }
          }
        }
      ]
    },
    {
      "name": "getStatus",
      "summary": "Current server status.",
      "description": "Returns the status: the lifecycle state, and while the server is running also the positioning mode and the last published solution. `seq` is the last event sequence number published when the content was determined; a client that has already received a later status event treats the response as stale.",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "status",
        "schema": {
          "$ref": "#/components/schemas/StatusResult"
        }
      },
      "examples": [
        {
          "name": "running with a fixed solution",
          "params": [],
          "result": {
            "name": "status",
            "value": {
              "seq": 1520,
              "status": {
                "lifecycle": {
                  "state": "running"
                },
                "mode": "kinematic",
                "solution": {
                  "time": {
                    "week": 2440,
                    "tow": 345600.25
                  },
                  "leapSeconds": 18,
                  "status": "fix",
                  "position": {
                    "ecef": {
                      "x": -3961904.912,
                      "y": 3348993.7695,
                      "z": 3698211.8312
                    },
                    "llh": {
                      "lat": 35.6658912345,
                      "lon": 139.7920123456,
                      "height": 59.8731
                    }
                  },
                  "covariance": {
                    "ecef": {
                      "xx": 0.0001,
                      "yy": 0.0001,
                      "zz": 0.0002,
                      "xy": 1e-05,
                      "yz": 2e-05,
                      "zx": -1e-05
                    },
                    "enu": {
                      "ee": 8e-05,
                      "nn": 9e-05,
                      "uu": 0.0003,
                      "en": 1e-05,
                      "nu": -2e-05,
                      "ue": 1e-05
                    }
                  },
                  "geoid": {
                    "separation": 36.7,
                    "model": "internal"
                  },
                  "validSatellites": 18,
                  "age": 0.6,
                  "ratio": 12.4,
                  "base": {
                    "ecef": {
                      "x": -3961900.0,
                      "y": 3348990.0,
                      "z": 3698200.0
                    },
                    "llh": {
                      "lat": 35.6658,
                      "lon": 139.792,
                      "height": 50.0
                    }
                  }
                }
              }
            }
          }
        },
        {
          "name": "stopped after a failed start",
          "params": [],
          "result": {
            "name": "status",
            "value": {
              "seq": 3,
              "status": {
                "lifecycle": {
                  "state": "stopped",
                  "stopReason": "error",
                  "lastError": {
                    "reason": "startFailed",
                    "message": "input stream 1 could not be opened"
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "sync",
      "summary": "Initial synchronization: a snapshot of all state and the event boundary.",
      "description": "Returns every state object the client tracks, taken at the same boundary: the snapshot reflects all events up to and including `seq` and none after it. Continue with getEvents(after = seq). In protocol 0.1 the only state object is `status`, so the result has the same shape as getStatus; later versions add `streams` and `satellites` next to `status`.",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "snapshot",
        "schema": {
          "$ref": "#/components/schemas/StatusResult"
        }
      }
    },
    {
      "name": "getEvents",
      "summary": "Events published after a given sequence number.",
      "description": "Returns held events with seq greater than `after`, in ascending seq order. If some of those events are no longer held, `lost` is true, `events` is empty and the client calls sync again.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "after",
          "required": true,
          "description": "Cursor: the seq returned by sync or the `next` of the previous getEvents on this connection. Must not exceed the last published seq.",
          "schema": {
            "$ref": "#/components/schemas/Seq"
          }
        },
        {
          "name": "limit",
          "required": false,
          "description": "Maximum number of events to return. The server may return fewer (it applies its own maximum); `more` tells whether more events are ready.",
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "result": {
        "name": "page",
        "schema": {
          "$ref": "#/components/schemas/EventsResult"
        }
      },
      "examples": [
        {
          "name": "a start and its outcome",
          "params": [
            {
              "name": "after",
              "value": 2
            }
          ],
          "result": {
            "name": "page",
            "value": {
              "events": [
                {
                  "seq": 3,
                  "kind": "status",
                  "data": {
                    "state": "starting"
                  }
                },
                {
                  "seq": 4,
                  "kind": "logMessage",
                  "data": {
                    "level": 1,
                    "text": "rtksvrstart: stream open ok"
                  }
                },
                {
                  "seq": 5,
                  "kind": "status",
                  "data": {
                    "state": "running"
                  }
                },
                {
                  "seq": 6,
                  "kind": "solution",
                  "data": {
                    "time": {
                      "week": 2440,
                      "tow": 345601.0
                    },
                    "leapSeconds": 18,
                    "status": "none"
                  }
                }
              ],
              "next": 6,
              "more": false,
              "lost": false
            }
          }
        },
        {
          "name": "events lost",
          "params": [
            {
              "name": "after",
              "value": 100
            }
          ],
          "result": {
            "name": "page",
            "value": {
              "events": [],
              "next": 100,
              "more": false,
              "lost": true,
              "oldestSeq": 4200
            }
          }
        }
      ],
      "errors": [
        {
          "$ref": "#/components/errors/InvalidParams"
        }
      ]
    },
    {
      "name": "start",
      "summary": "Start positioning.",
      "description": "Accepted when the server is stopped: the server moves to `starting` and the response returns. The outcome arrives as a later status event: `running`, or `stopped` with stopReason `error` and lastError.",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "accepted",
        "schema": {
          "$ref": "#/components/schemas/AcceptedResult"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/AlreadyRunning"
        },
        {
          "$ref": "#/components/errors/Busy"
        },
        {
          "$ref": "#/components/errors/ShuttingDown"
        }
      ]
    },
    {
      "name": "stop",
      "summary": "Stop positioning.",
      "description": "Accepted when the server is running: the server moves to `stopping` and the response returns; `stopped` follows as a status event. When the server is already stopped the request succeeds without effect.",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "accepted",
        "schema": {
          "$ref": "#/components/schemas/AcceptedResult"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/Busy"
        },
        {
          "$ref": "#/components/errors/ShuttingDown"
        }
      ]
    },
    {
      "name": "restart",
      "summary": "Stop and start again without letting other lifecycle requests in between.",
      "description": "When running: status events `stopping`, `stopped`, `starting`, then `running` or `stopped` with lastError. Until the restart has finished, other lifecycle requests fail with `busy`, also while the intermediate `stopped` is shown. When stopped: the same as start.",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "accepted",
        "schema": {
          "$ref": "#/components/schemas/AcceptedResult"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/Busy"
        },
        {
          "$ref": "#/components/errors/ShuttingDown"
        }
      ]
    },
    {
      "name": "shutdown",
      "summary": "Stop positioning if running, save navigation data and exit the process.",
      "description": "Accepted in every state, including during a transition: it is recorded and carried out when the transition ends. The response only confirms acceptance; the connection then closes when the process exits. Repeating the request is accepted again without further effect.",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "accepted",
        "schema": {
          "$ref": "#/components/schemas/AcceptedResult"
        }
      }
    }
  ],
  "components": {
    "schemas": {
      "Seq": {
        "title": "Event sequence number",
        "description": "One sequence for all event kinds, increasing in publish order for the life of the process. 0 means that no event has been published yet. Always below 2^53.",
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "VersionResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocolVersion",
          "mrtklibVersion",
          "authentication"
        ],
        "properties": {
          "protocolVersion": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+$",
            "description": "MAJOR.MINOR of this protocol."
          },
          "mrtklibVersion": {
            "type": "string",
            "description": "MRTKLIB version of the server, for display."
          },
          "authentication": {
            "type": "string",
            "enum": [
              "token",
              "none"
            ],
            "description": "`none` only when the server was started with --rpc-no-auth (for testing)."
          }
        }
      },
      "LifecycleState": {
        "type": "string",
        "enum": [
          "stopped",
          "starting",
          "running",
          "stopping"
        ]
      },
      "StopReason": {
        "type": "string",
        "enum": [
          "request",
          "inputEnd",
          "error"
        ],
        "description": "`request`: a stop, restart or shutdown request from any interface or a signal. `inputEnd`: all inputs were files and all were read to the end. `error`: the start failed (see lastError)."
      },
      "LastError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason",
          "message"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "description": "Stable name. Open set: clients treat names they do not know like `startFailed`. Known in 0.1: `startFailed`."
          },
          "message": {
            "type": "string",
            "description": "English description for display. Not part of the contract. Never contains secrets."
          }
        }
      },
      "Lifecycle": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "$ref": "#/components/schemas/LifecycleState"
          },
          "stopReason": {
            "$ref": "#/components/schemas/StopReason",
            "description": "Present in `stopping` and `stopped`, except before the first start."
          },
          "lastError": {
            "$ref": "#/components/schemas/LastError",
            "description": "The most recent start failure. Present from the failure until a start succeeds: in `stopped` with stopReason `error`, and in a following `starting`."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "running",
                    "starting"
                  ]
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "stopReason"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "stopping"
                }
              }
            },
            "then": {
              "required": [
                "stopReason"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "running",
                    "stopping"
                  ]
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "lastError"
                ]
              }
            }
          },
          {
            "if": {
              "required": [
                "stopReason"
              ],
              "properties": {
                "stopReason": {
                  "const": "error"
                }
              }
            },
            "then": {
              "required": [
                "lastError"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "stopped"
                }
              },
              "not": {
                "required": [
                  "stopReason"
                ],
                "properties": {
                  "stopReason": {
                    "const": "error"
                  }
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "lastError"
                ]
              }
            }
          }
        ]
      },
      "PositioningMode": {
        "type": "string",
        "description": "Value of the configuration key `positioning.mode` in its TOML form, e.g. `kinematic`, `ppp-kine`, `ppp-rtk`. See docs/reference/config-options.md."
      },
      "Status": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lifecycle"
        ],
        "properties": {
          "lifecycle": {
            "$ref": "#/components/schemas/Lifecycle"
          },
          "mode": {
            "$ref": "#/components/schemas/PositioningMode",
            "description": "Present only while running."
          },
          "solution": {
            "$ref": "#/components/schemas/Solution",
            "description": "The last published solution event. Present only while running and after the first solution of the run."
          }
        },
        "if": {
          "properties": {
            "lifecycle": {
              "properties": {
                "state": {
                  "const": "running"
                }
              }
            }
          }
        },
        "then": {
          "required": [
            "mode"
          ]
        },
        "else": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "mode"
                ]
              },
              {
                "required": [
                  "solution"
                ]
              }
            ]
          }
        }
      },
      "StatusResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seq",
          "status"
        ],
        "properties": {
          "seq": {
            "$ref": "#/components/schemas/Seq",
            "description": "Last event seq published when the content was determined."
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        }
      },
      "AcceptedResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seq"
        ],
        "properties": {
          "seq": {
            "$ref": "#/components/schemas/Seq",
            "description": "Last seq published when the request took effect, including the transition event the request published itself. Events with a greater seq show the outcome."
          }
        }
      },
      "GpsTime": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "week",
          "tow"
        ],
        "properties": {
          "week": {
            "type": "integer",
            "minimum": 0,
            "description": "GPS week number since 1980-01-06, not truncated to 10 bits."
          },
          "tow": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 604800,
            "description": "Time of week in GPST (s), nanosecond resolution."
          }
        }
      },
      "SolutionStatus": {
        "type": "string",
        "enum": [
          "none",
          "fix",
          "float",
          "sbas",
          "dgps",
          "single",
          "ppp",
          "dr"
        ]
      },
      "Ecef": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y",
          "z"
        ],
        "properties": {
          "x": {
            "type": "number",
            "description": "m"
          },
          "y": {
            "type": "number",
            "description": "m"
          },
          "z": {
            "type": "number",
            "description": "m"
          }
        }
      },
      "Llh": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lat",
          "lon",
          "height"
        ],
        "properties": {
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "description": "Geodetic latitude (deg, WGS84 ellipsoid)."
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "description": "Longitude (deg)."
          },
          "height": {
            "type": "number",
            "description": "Ellipsoidal height (m). Subtract geoid.separation for the orthometric height."
          }
        }
      },
      "Position": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ecef",
          "llh"
        ],
        "properties": {
          "ecef": {
            "$ref": "#/components/schemas/Ecef"
          },
          "llh": {
            "$ref": "#/components/schemas/Llh"
          }
        }
      },
      "CovarianceEcef": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "xx",
          "yy",
          "zz",
          "xy",
          "yz",
          "zx"
        ],
        "properties": {
          "xx": {
            "type": "number"
          },
          "yy": {
            "type": "number"
          },
          "zz": {
            "type": "number"
          },
          "xy": {
            "type": "number"
          },
          "yz": {
            "type": "number"
          },
          "zx": {
            "type": "number"
          }
        },
        "description": "Position covariance in ECEF (m^2)."
      },
      "CovarianceEnu": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ee",
          "nn",
          "uu",
          "en",
          "nu",
          "ue"
        ],
        "properties": {
          "ee": {
            "type": "number"
          },
          "nn": {
            "type": "number"
          },
          "uu": {
            "type": "number"
          },
          "en": {
            "type": "number"
          },
          "nu": {
            "type": "number"
          },
          "ue": {
            "type": "number"
          }
        },
        "description": "Position covariance in the local east-north-up frame at the solution position (m^2)."
      },
      "Covariance": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ecef",
          "enu"
        ],
        "properties": {
          "ecef": {
            "$ref": "#/components/schemas/CovarianceEcef"
          },
          "enu": {
            "$ref": "#/components/schemas/CovarianceEnu"
          }
        }
      },
      "Geoid": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model"
        ],
        "properties": {
          "separation": {
            "type": "number",
            "not": {
              "const": 0
            },
            "description": "Geoid height above the ellipsoid at the solution position (m). Absent when the model gives no value; never exactly 0, because a zero result of the geoid model means no value."
          },
          "model": {
            "type": "string",
            "enum": [
              "internal",
              "egm96",
              "egm08_2.5",
              "egm08_1",
              "gsi2000"
            ],
            "description": "Geoid model used: the configuration key `output.geoid_model`."
          }
        }
      },
      "Solution": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "time",
          "leapSeconds",
          "status"
        ],
        "properties": {
          "time": {
            "$ref": "#/components/schemas/GpsTime"
          },
          "leapSeconds": {
            "type": "integer",
            "description": "GPST - UTC (s) that the server used for this epoch. UTC = GPST - leapSeconds."
          },
          "status": {
            "$ref": "#/components/schemas/SolutionStatus"
          },
          "position": {
            "$ref": "#/components/schemas/Position"
          },
          "covariance": {
            "$ref": "#/components/schemas/Covariance"
          },
          "geoid": {
            "$ref": "#/components/schemas/Geoid",
            "description": "Present for every solution other than `none`."
          },
          "validSatellites": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of valid satellites in the solution."
          },
          "age": {
            "type": "number",
            "description": "Age of differential corrections (s), as the engine reports it. A mode that does not compute it leaves 0. Its exact meaning depends on the positioning mode."
          },
          "ratio": {
            "type": "number",
            "description": "Ambiguity validation ratio (second-best to best candidate). 0 is also used when no ambiguity resolution was done for the epoch."
          },
          "base": {
            "$ref": "#/components/schemas/Position",
            "description": "Base station position used for this solution (height ellipsoidal). Absent when the mode uses no base station or its position is not known yet."
          }
        },
        "if": {
          "properties": {
            "status": {
              "const": "none"
            }
          }
        },
        "then": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "position"
                ]
              },
              {
                "required": [
                  "covariance"
                ]
              },
              {
                "required": [
                  "geoid"
                ]
              },
              {
                "required": [
                  "validSatellites"
                ]
              },
              {
                "required": [
                  "age"
                ]
              },
              {
                "required": [
                  "ratio"
                ]
              },
              {
                "required": [
                  "base"
                ]
              }
            ]
          }
        },
        "else": {
          "required": [
            "position",
            "covariance",
            "geoid",
            "validSatellites",
            "age",
            "ratio"
          ]
        }
      },
      "LogMessage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "text"
        ],
        "properties": {
          "level": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "description": "The lowest selected log level at which the message is delivered. 1 (the default): errors from all positioning engines and warnings from the RTK and VRS engines. 2: also detailed diagnostics."
          },
          "text": {
            "type": "string",
            "description": "Human-readable text. Not part of the contract: display it, do not parse it. Never contains secrets."
          }
        }
      },
      "StatusEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seq",
          "kind",
          "data"
        ],
        "properties": {
          "seq": {
            "$ref": "#/components/schemas/Seq"
          },
          "kind": {
            "const": "status"
          },
          "data": {
            "$ref": "#/components/schemas/Lifecycle"
          }
        }
      },
      "SolutionEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seq",
          "kind",
          "data"
        ],
        "properties": {
          "seq": {
            "$ref": "#/components/schemas/Seq"
          },
          "kind": {
            "const": "solution"
          },
          "data": {
            "$ref": "#/components/schemas/Solution"
          }
        }
      },
      "LogMessageEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seq",
          "kind",
          "data"
        ],
        "properties": {
          "seq": {
            "$ref": "#/components/schemas/Seq"
          },
          "kind": {
            "const": "logMessage"
          },
          "data": {
            "$ref": "#/components/schemas/LogMessage"
          }
        }
      },
      "Event": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/StatusEvent"
          },
          {
            "$ref": "#/components/schemas/SolutionEvent"
          },
          {
            "$ref": "#/components/schemas/LogMessageEvent"
          }
        ]
      },
      "EventsResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "events",
          "next",
          "more",
          "lost"
        ],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          },
          "next": {
            "$ref": "#/components/schemas/Seq",
            "description": "Cursor for the next call: the seq of the last returned event, or `after` when none was returned."
          },
          "more": {
            "type": "boolean",
            "description": "True when more events after `next` are ready now."
          },
          "lost": {
            "type": "boolean",
            "description": "True when events after `after` are no longer held. Call sync again."
          },
          "oldestSeq": {
            "$ref": "#/components/schemas/Seq",
            "description": "Present when lost: the oldest seq still held."
          }
        },
        "if": {
          "properties": {
            "lost": {
              "const": true
            }
          }
        },
        "then": {
          "required": [
            "oldestSeq"
          ],
          "properties": {
            "events": {
              "maxItems": 0
            }
          }
        },
        "else": {
          "not": {
            "required": [
              "oldestSeq"
            ]
          }
        }
      },
      "ErrorData": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "description": "Stable error name; branch on this, not on `message`."
          },
          "state": {
            "$ref": "#/components/schemas/LifecycleState",
            "description": "With `busy`: the state that caused the rejection."
          }
        }
      }
    },
    "errors": {
      "InvalidParams": {
        "code": -32602,
        "message": "Invalid params",
        "data": {
          "reason": "invalidParams"
        }
      },
      "Busy": {
        "code": 1001,
        "message": "Busy",
        "data": {
          "reason": "busy",
          "state": "starting"
        }
      },
      "AlreadyRunning": {
        "code": 1002,
        "message": "Already running",
        "data": {
          "reason": "alreadyRunning"
        }
      },
      "ShuttingDown": {
        "code": 1003,
        "message": "Shutting down",
        "data": {
          "reason": "shuttingDown"
        }
      }
    }
  }
}
